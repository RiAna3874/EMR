// Meridian EMR data model. Tables mirror FHIR R4 resources (see plan spec §3)
// so the clinical structure stays honest and a FHIR export is possible later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sex {
  male
  female
  other
  unknown
}

enum Role {
  physician
  resident
  nurse
  front_desk
}

// "No known allergies" is an explicit, reviewed state, distinct from "not reviewed".
enum AllergyReviewStatus {
  not_reviewed
  no_known_allergies
  has_allergies
}

enum EncounterType {
  office
  telehealth
  phone
}

enum EncounterStatus {
  planned
  arrived
  in_progress
  finished
  cancelled
}

enum ConditionStatus {
  active
  resolved
}

enum AllergySeverity {
  mild
  moderate
  severe
}

enum AllergyType {
  drug
  food
  environment
  other
}

// replaced = superseded by a newer prescription for the same therapy (a reorder,
// a dose change or an approved refill); see MedicationRequest.priorId.
enum MedStatus {
  active
  on_hold
  discontinued
  completed
  replaced
}

// How a prescription leaves the clinic. historical = documented here but
// prescribed elsewhere (or over the counter); nothing is sent.
enum RxClass {
  e_prescribe
  print
  phone
  historical
}

// What the patient says they actually do, recorded at medication review.
enum PatientTaking {
  taking
  not_taking
  taking_differently
}

// A pharmacy's renewal request. pended = a nurse has prepared it for a prescriber.
enum RefillStatus {
  requested
  pended
  approved
  denied
}

enum ObservationCategory {
  vital_signs
  laboratory
}

// N normal, L/H low/high, LL/HH critical, A abnormal (non-numeric)
enum Flag {
  N
  L
  H
  LL
  HH
  A
}

enum ReportStatus {
  preliminary
  final
}

enum ReportSource {
  ordered
  imported
}

// What an import is read as: lab results, or an outside clinical document
// (imaging report, discharge summary, letter...) filed as a ClinicalDocument.
enum ImportKind {
  lab
  document
}

enum ClinicalDocType {
  imaging_report
  discharge_summary
  referral_letter
  consult_note
  procedure_note
  pathology_report
  other
}

enum ImportStatus {
  extracting
  needs_review
  failed
  filed
  discarded
}

enum OrderType {
  lab
  imaging
  medication
  referral
  procedure
}

// pending = in the unsigned "cart"; signed = active, waiting to be done or resulted.
enum OrderStatus {
  pending
  signed
  completed
  discontinued
}

enum OrderPriority {
  routine
  urgent
  stat
}

enum NoteType {
  progress
  history_physical
  consult
  procedure
  phone
}

// draft = pended (saved, unsigned); pending_cosign = signed by the author, waiting
// on a supervising clinician; addended = signed, with one or more addenda.
enum NoteStatus {
  draft
  pending_cosign
  signed
  addended
}

model Practitioner {
  id           String    @id @default(cuid())
  name         String
  role         Role
  credentials  String?
  createdAt    DateTime  @default(now())
  // Sign-in. Synthetic accounts only; see prisma/seed.ts.
  username     String?   @unique
  passwordHash String? // scrypt, see src/lib/password.ts
  active       Boolean   @default(true)
  sessions     Session[]

  primaryPatients   Patient[]           @relation("PCP")
  encounters        Encounter[]
  prescriptions     MedicationRequest[]
  notes             Note[]              @relation("NoteAuthor")
  cosignNotes       Note[]              @relation("NoteCosigner")
  addenda           NoteAddendum[]
  phrases           SmartPhrase[]
  verifiedReports   DiagnosticReport[]  @relation("VerifiedReports")
  uploads           DocumentReference[]
  importJobs        ImportJob[]         @relation("ImportCreatedBy")
  filedImports      ImportJob[]         @relation("ImportFiledBy")
  reviewedReports   DiagnosticReport[]  @relation("ReviewedReports")
  orders            ServiceRequest[]
  cosignMeds        MedicationRequest[] @relation("MedCosigner")
  endedMeds         MedicationRequest[] @relation("MedEndedBy")
  medsReviewed      Patient[]           @relation("MedsReviewer")
  refillsPended     RefillRequest[]     @relation("RefillPendedBy")
  refillsDecided    RefillRequest[]     @relation("RefillDecidedBy")
  filedDocuments    ClinicalDocument[]  @relation("DocFiledBy")
  reviewedDocuments ClinicalDocument[]  @relation("DocReviewedBy")
}

// A signed-in browser. The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id             String       @id // sha256(token), hex
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  lastSeenAt     DateTime     @default(now())
  expiresAt      DateTime

  @@index([practitionerId])
}

model Patient {
  id                  String              @id @default(cuid())
  mrn                 String              @unique
  firstName           String
  lastName            String
  dob                 DateTime            @db.Date
  sex                 Sex
  phone               String?
  address             String?
  preferredLanguage   String              @default("English")
  codeStatus          String              @default("Full code")
  allergyStatus       AllergyReviewStatus @default(not_reviewed)
  pcpId               String?
  pcp                 Practitioner?       @relation("PCP", fields: [pcpId], references: [id])
  createdAt           DateTime            @default(now())
  preferredPharmacyId String?
  preferredPharmacy   Pharmacy?           @relation(fields: [preferredPharmacyId], references: [id])
  // "Mark as reviewed" on the medication list.
  medsReviewedAt      DateTime?
  medsReviewedById    String?
  medsReviewedBy      Practitioner?       @relation("MedsReviewer", fields: [medsReviewedById], references: [id])

  encounters     Encounter[]
  conditions     Condition[]
  allergies      AllergyIntolerance[]
  medications    MedicationRequest[]
  observations   Observation[]
  reports        DiagnosticReport[]
  notes          Note[]
  documents      DocumentReference[]
  importJobs     ImportJob[]
  orders         ServiceRequest[]
  dispenses      MedicationDispense[]
  refillRequests RefillRequest[]
  clinicalDocs   ClinicalDocument[]

  @@index([lastName, firstName])
}

model Encounter {
  id         String          @id @default(cuid())
  patientId  String
  patient    Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type       EncounterType
  status     EncounterStatus
  reason     String?
  start      DateTime
  end        DateTime?
  providerId String?
  provider   Practitioner?   @relation(fields: [providerId], references: [id])

  observations Observation[]
  notes        Note[]

  @@index([patientId, start])
  @@index([start])
}

model Condition {
  id         String          @id @default(cuid())
  patientId  String
  patient    Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  code       String // ICD-10-CM
  display    String
  status     ConditionStatus
  onset      DateTime?       @db.Date
  resolvedAt DateTime?       @db.Date
  priority   Int             @default(100) // lower sorts first
  comment    String?

  @@index([patientId])
}

model AllergyIntolerance {
  id         String          @id @default(cuid())
  patientId  String
  patient    Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  substance  String
  type       AllergyType
  reaction   String?
  severity   AllergySeverity
  verified   Boolean         @default(false)
  recordedAt DateTime        @default(now())

  @@index([patientId])
}

// One prescription (FHIR MedicationRequest). A reorder, dose change or approved
// refill writes a new row whose priorId points at the one it replaces, so the
// list shows the current prescription and the chain is the history.
model MedicationRequest {
  id                  String             @id @default(cuid())
  patientId           String
  patient             Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  drug                String
  rxnorm              String?
  dose                String
  route               String
  frequency           String
  prn                 Boolean            @default(false)
  prnReason           String?
  indication          String?
  status              MedStatus
  start               DateTime           @db.Date // when the patient started this therapy
  end                 DateTime?          @db.Date
  prescriberId        String?
  prescriber          Practitioner?      @relation(fields: [prescriberId], references: [id])
  // The prescription itself.
  rxClass             RxClass            @default(e_prescribe)
  authoredAt          DateTime           @default(now())
  quantity            String?
  daysSupply          Int?
  refills             Int                @default(0) // authorized refills (fills after the first)
  daw                 Boolean            @default(false) // dispense as written, no substitution
  patientInstructions String?
  pharmacyNote        String?
  pharmacyId          String?
  pharmacy            Pharmacy?          @relation(fields: [pharmacyId], references: [id])
  sentAt              DateTime?
  priorId             String?            @unique
  prior               MedicationRequest? @relation("PriorRx", fields: [priorId], references: [id])
  next                MedicationRequest? @relation("PriorRx")
  endReason           String?
  endedById           String?
  endedBy             Practitioner?      @relation("MedEndedBy", fields: [endedById], references: [id])
  // Patient-reported use, from the last medication review.
  taking              PatientTaking?
  takingNote          String?
  takingAt            DateTime?
  // A resident's prescription waits on an attending's cosignature (it is still sent).
  cosignerId          String?
  cosigner            Practitioner?      @relation("MedCosigner", fields: [cosignerId], references: [id])
  cosignedAt          DateTime?

  dispenses      MedicationDispense[]
  refillRequests RefillRequest[]      @relation("RefillFor")
  refillResults  RefillRequest[]      @relation("RefillResult")

  @@index([patientId])
  @@index([cosignerId, cosignedAt])
}

model Pharmacy {
  id        String  @id @default(cuid())
  name      String
  address   String
  phone     String
  fax       String?
  mailOrder Boolean @default(false)

  patients       Patient[]
  prescriptions  MedicationRequest[]
  dispenses      MedicationDispense[]
  refillRequests RefillRequest[]
}

// A pharmacy fill, as reported back by the pharmacy (simulated in the seed).
model MedicationDispense {
  id           String            @id @default(cuid())
  patientId    String
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicationId String
  medication   MedicationRequest @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  pharmacyId   String?
  pharmacy     Pharmacy?         @relation(fields: [pharmacyId], references: [id])
  filledAt     DateTime
  quantity     String
  daysSupply   Int

  @@index([medicationId, filledAt])
}

// A pharmacy asking to renew a prescription that is out of refills.
model RefillRequest {
  id              String             @id @default(cuid())
  patientId       String
  patient         Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicationId    String
  medication      MedicationRequest  @relation("RefillFor", fields: [medicationId], references: [id], onDelete: Cascade)
  pharmacyId      String?
  pharmacy        Pharmacy?          @relation(fields: [pharmacyId], references: [id])
  status          RefillStatus       @default(requested)
  requestedAt     DateTime           @default(now())
  pharmacyComment String?
  pendedById      String?
  pendedBy        Practitioner?      @relation("RefillPendedBy", fields: [pendedById], references: [id])
  pendedAt        DateTime?
  pendNote        String?
  decidedById     String?
  decidedBy       Practitioner?      @relation("RefillDecidedBy", fields: [decidedById], references: [id])
  decidedAt       DateTime?
  decisionNote    String? // deny reason, or a note sent with the approval
  resultId        String? // the new prescription an approval wrote
  result          MedicationRequest? @relation("RefillResult", fields: [resultId], references: [id])

  @@index([status])
  @@index([patientId])
}

model Observation {
  id          String              @id @default(cuid())
  patientId   String
  patient     Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId String?
  encounter   Encounter?          @relation(fields: [encounterId], references: [id])
  reportId    String?
  report      DiagnosticReport?   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  category    ObservationCategory
  code        String // LOINC, or a local code for vitals without one
  display     String
  valueNum    Float?
  valueText   String?
  unit        String? // UCUM
  refLow      Float?
  refHigh     Float?
  refText     String?
  flag        Flag?
  effectiveAt DateTime
  sortOrder   Int                 @default(0)

  @@index([patientId, category, effectiveAt])
}

model DiagnosticReport {
  id            String          @id @default(cuid())
  patientId     String
  patient       Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  code          String
  display       String // e.g. "Complete blood count"
  performer     String // lab name
  effectiveAt   DateTime
  issuedAt      DateTime
  status        ReportStatus
  source        ReportSource    @default(ordered)
  verifiedAt    DateTime?
  verifiedById  String?
  verifiedBy    Practitioner?   @relation("VerifiedReports", fields: [verifiedById], references: [id])
  importJobId   String?
  importJob     ImportJob?      @relation(fields: [importJobId], references: [id])
  orderId       String?
  order         ServiceRequest? @relation(fields: [orderId], references: [id])
  // Inbox acknowledgement by the responsible clinician.
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    Practitioner?   @relation("ReviewedReports", fields: [reviewedById], references: [id])
  reviewComment String?

  observations Observation[]

  @@index([patientId, effectiveAt])
  @@index([reviewedAt])
}

model Note {
  id          String        @id @default(cuid())
  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId String?
  encounter   Encounter?    @relation(fields: [encounterId], references: [id])
  type        NoteType
  templateId  String? // src/lib/notes/library.ts
  title       String
  body        String
  status      NoteStatus
  authorId    String
  author      Practitioner  @relation("NoteAuthor", fields: [authorId], references: [id])
  serviceAt   DateTime      @default(now()) // date of service
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @default(now()) @updatedAt
  signedAt    DateTime?
  // Supervision: a note routed for cosignature stays pending_cosign until the
  // cosigner signs, optionally adding an attestation.
  cosignerId  String?
  cosigner    Practitioner? @relation("NoteCosigner", fields: [cosignerId], references: [id])
  cosignedAt  DateTime?
  cosignText  String?

  addenda NoteAddendum[]

  @@index([patientId, serviceAt])
  @@index([authorId, status])
  @@index([cosignerId, status])
}

// Signed notes are never edited; later information is appended as an addendum.
model NoteAddendum {
  id       String       @id @default(cuid())
  noteId   String
  note     Note         @relation(fields: [noteId], references: [id], onDelete: Cascade)
  body     String
  authorId String
  author   Practitioner @relation(fields: [authorId], references: [id])
  signedAt DateTime     @default(now())

  @@index([noteId])
}

// A clinician's own dot phrase. It overrides a system phrase with the same name.
model SmartPhrase {
  id          String       @id @default(cuid())
  ownerId     String
  owner       Practitioner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String       @default("")
  body        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([ownerId, name])
}

// An uploaded file (photo, scan or PDF). Bytes live in Postgres for v1; move to
// object storage when files get large or numerous.
model DocumentReference {
  id           String       @id @default(cuid())
  patientId    String
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind         String       @default("lab_report")
  fileName     String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  data         Bytes
  uploadedById String
  uploadedBy   Practitioner @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime     @default(now())
  importJobId  String?
  importJob    ImportJob?   @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  position     Int          @default(0) // page order within an import

  @@index([patientId, uploadedAt])
}

// One lab report import: the uploaded pages, what Claude read from them, and the
// clinician's reviewed draft. Nothing reaches the chart until it is filed.
model ImportJob {
  id          String        @id @default(cuid())
  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind        ImportKind    @default(lab)
  status      ImportStatus  @default(extracting)
  model       String?
  extraction  Json? // raw model output, kept for audit
  draft       Json? // the review screen's working copy
  error       String?
  createdById String
  createdBy   Practitioner  @relation("ImportCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  filedAt     DateTime?
  filedById   String?
  filedBy     Practitioner? @relation("ImportFiledBy", fields: [filedById], references: [id])

  documents   DocumentReference[]
  reports     DiagnosticReport[]
  clinicalDoc ClinicalDocument?

  @@index([patientId, createdAt])
  @@index([status])
}

// An order (FHIR ServiceRequest, or MedicationRequest once a prescription is
// signed). `code` is the orderable's code from src/lib/orders/catalog.ts.
model ServiceRequest {
  id             String        @id @default(cuid())
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type           OrderType
  code           String
  display        String
  status         OrderStatus   @default(pending)
  priority       OrderPriority @default(routine)
  indication     String?
  instructions   String?
  details        Json? // medication: dose, route, frequency, quantity, refills
  orderSet       String?
  expectedAt     DateTime?     @db.Date
  orderedById    String
  orderedBy      Practitioner  @relation(fields: [orderedById], references: [id])
  createdAt      DateTime      @default(now())
  signedAt       DateTime?
  completedAt    DateTime?
  discontinuedAt DateTime?
  medicationId   String? // the MedicationRequest a signed prescription created

  reports      DiagnosticReport[]
  clinicalDocs ClinicalDocument[]

  @@index([patientId, status])
  @@index([orderedById, status])
}

// An outside clinical document filed from a verified import: an imaging report,
// discharge summary, referral or consult letter. `content` holds the reviewed
// structure (sections, diagnoses, medications, follow-ups; see
// src/lib/documents/draft.ts DocContent). The source pages stay on the import job.
model ClinicalDocument {
  id            String          @id @default(cuid())
  patientId     String
  patient       Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type          ClinicalDocType
  title         String
  organization  String?
  author        String?
  serviceDate   DateTime        @db.Date
  content       Json
  importJobId   String?         @unique
  importJob     ImportJob?      @relation(fields: [importJobId], references: [id])
  // The imaging or referral order this document answers, if any.
  orderId       String?
  order         ServiceRequest? @relation(fields: [orderId], references: [id])
  filedById     String
  filedBy       Practitioner    @relation("DocFiledBy", fields: [filedById], references: [id])
  filedAt       DateTime        @default(now())
  // Inbox acknowledgement by the PCP (or the ordering clinician).
  reviewedAt    DateTime?
  reviewedById  String?
  reviewedBy    Practitioner?   @relation("DocReviewedBy", fields: [reviewedById], references: [id])
  reviewComment String?

  @@index([patientId, serviceDate])
  @@index([reviewedAt])
}
