// Meridian EMR data model. Tables mirror FHIR R4 resources (see plan spec §3)
// so the clinical structure stays honest and a FHIR export is possible later.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sex {
  male
  female
  other
  unknown
}

enum Role {
  physician
  resident
  nurse
  front_desk
}

// "No known allergies" is an explicit, reviewed state, distinct from "not reviewed".
// What colleagues see next to a name in secure chat.
enum ChatStatus {
  available
  busy
  away
}

enum ChatMessageKind {
  text
  system // "Kirsten Lund added Leo Brandt", "... left", "... renamed"
}

enum AllergyReviewStatus {
  not_reviewed
  no_known_allergies
  has_allergies
}

enum EncounterType {
  office
  telehealth
  phone
}

// The appointment's place in the clinic day: scheduled, checked in at the front
// desk, roomed by a nurse, with the provider, visit done, checked out. See
// src/lib/scheduling/workflow.ts for the allowed transitions.
enum EncounterStatus {
  planned
  arrived
  roomed
  in_progress
  finished
  checked_out
  no_show
  cancelled
}

enum ConditionStatus {
  active
  resolved
}

enum AllergySeverity {
  mild
  moderate
  severe
}

enum AllergyType {
  drug
  food
  environment
  other
}

// replaced = superseded by a newer prescription for the same therapy (a reorder,
// a dose change or an approved refill); see MedicationRequest.priorId.
enum MedStatus {
  active
  on_hold
  discontinued
  completed
  replaced
}

// How a prescription leaves the clinic. historical = documented here but
// prescribed elsewhere (or over the counter); nothing is sent.
enum RxClass {
  e_prescribe
  print
  phone
  historical
}

// What the patient says they actually do, recorded at medication review.
enum PatientTaking {
  taking
  not_taking
  taking_differently
}

// A pharmacy's renewal request. pended = a nurse has prepared it for a prescriber.
enum RefillStatus {
  requested
  pended
  approved
  denied
}

enum ObservationCategory {
  vital_signs
  laboratory
}

// N normal, L/H low/high, LL/HH critical, A abnormal (non-numeric)
enum Flag {
  N
  L
  H
  LL
  HH
  A
}

enum ReportStatus {
  preliminary
  final
}

enum ReportSource {
  ordered
  imported
}

// What an import is read as: lab results, or an outside clinical document
// (imaging report, discharge summary, letter...) filed as a ClinicalDocument.
enum ImportKind {
  lab
  document
}

enum ClinicalDocType {
  imaging_report
  discharge_summary
  referral_letter
  consult_note
  procedure_note
  pathology_report
  other
}

enum ImportStatus {
  extracting
  needs_review
  failed
  filed
  discarded
}

enum OrderType {
  lab
  imaging
  medication
  referral
  procedure
}

// pending = in the unsigned "cart"; signed = active, waiting to be done or resulted.
enum OrderStatus {
  pending
  signed
  completed
  discontinued
}

enum OrderPriority {
  routine
  urgent
  stat
}

enum NoteType {
  progress
  history_physical
  consult
  procedure
  phone
}

// draft = pended (saved, unsigned); pending_cosign = signed by the author, waiting
// on a supervising clinician; addended = signed, with one or more addenda.
enum NoteStatus {
  draft
  pending_cosign
  signed
  addended
}

model Practitioner {
  id                 String            @id @default(cuid())
  name               String
  role               Role
  credentials        String?
  // Medical council registration (BMDC in Bangladesh), printed on prescriptions.
  registrationNumber String?
  createdAt          DateTime          @default(now())
  // Sign-in. Accounts are made at /setup (the first admin) and /admin/users; the demo seed makes synthetic ones.
  username           String?           @unique
  passwordHash       String? // scrypt, see src/lib/password.ts
  active             Boolean           @default(true)
  // Manages staff accounts at /admin/users. Separate from the clinical role.
  isAdmin            Boolean           @default(false)
  // Set when an admin issues a temporary password; the user must pick their own before using the app.
  mustChangePassword Boolean           @default(false)
  // Two-step sign-in with an authenticator app (TOTP, src/lib/totp.ts). Set up at /account/two-step.
  totpSecret         String? // base32; null until set up
  totpPendingSecret  String? // shown as a QR code while setting up, until the first code is confirmed
  totpEnabledAt      DateTime?
  totpLastStep       Int? // the last 30-second step used, so a code can't be used twice
  recoveryCodes      String[]          @default([]) // sha256 of each unused one-time recovery code
  // Orderable codes (or "SET:<id>" for an order set) starred on the Orders tab.
  orderFavorites     String[]          @default([])
  // Wrong passwords in a row (sign-in or unlock); five lock sign-in until signInLockedUntil.
  failedSignIns      Int               @default(0)
  signInLockedUntil  DateTime?
  sessions           Session[]
  signInChallenges   SignInChallenge[]

  primaryPatients    Patient[]            @relation("PCP")
  encounters         Encounter[]
  prescriptions      MedicationRequest[]
  notes              Note[]               @relation("NoteAuthor")
  cosignNotes        Note[]               @relation("NoteCosigner")
  addenda            NoteAddendum[]
  editedNotes        Note[]               @relation("NoteEditor")
  noteVersions       NoteVersion[]        @relation("NoteVersionSigner")
  phrases            SmartPhrase[]
  verifiedReports    DiagnosticReport[]   @relation("VerifiedReports")
  uploads            DocumentReference[]
  mediaUploads       MediaItem[]
  importJobs         ImportJob[]          @relation("ImportCreatedBy")
  filedImports       ImportJob[]          @relation("ImportFiledBy")
  reviewedReports    DiagnosticReport[]   @relation("ReviewedReports")
  resultCorrections  ObservationCorrection[]
  orders             ServiceRequest[]
  cosignMeds         MedicationRequest[]  @relation("MedCosigner")
  endedMeds          MedicationRequest[]  @relation("MedEndedBy")
  medsReviewed       Patient[]            @relation("MedsReviewer")
  registeredPatients Patient[]            @relation("RegisteredBy")
  refillsPended      RefillRequest[]      @relation("RefillPendedBy")
  refillsDecided     RefillRequest[]      @relation("RefillDecidedBy")
  filedDocuments     ClinicalDocument[]   @relation("DocFiledBy")
  reviewedDocuments  ClinicalDocument[]   @relation("DocReviewedBy")
  scheduleSessions   ScheduleSession[]
  scheduleBlocks     ScheduleBlock[]      @relation("BlockProvider")
  encounterEvents    EncounterEvent[]
  visitDiagnoses     EncounterDiagnosis[] @relation("DiagnosisAddedBy")
  // Secure chat.
  chatStatus         ChatStatus           @default(available)
  chatStatusNote     String?
  conversationsMade  Conversation[]       @relation("ConversationCreatedBy")
  chatMemberships    ConversationMember[]
  chatMessages       ChatMessage[]
}

// A signed-in browser. The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id             String       @id // sha256(token), hex
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  lastSeenAt     DateTime     @default(now())
  expiresAt      DateTime
  // Screen locked after being left idle (src/components/idle-lock.tsx); the password unlocks it.
  lockedAt       DateTime?

  @@index([practitionerId])
}

// Between a correct password and the authenticator code. The cookie holds the token; this row its sha256.
model SignInChallenge {
  id             String       @id
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  next           String
  attempts       Int          @default(0)
  createdAt      DateTime     @default(now())
  expiresAt      DateTime
}

// The access log: who opened, printed or changed which chart, and every sign-in. Written by
// src/lib/audit; read at /admin/access-log. Append-only: a database trigger refuses UPDATE
// and DELETE. Plain columns, no foreign keys, so entries outlive accounts and charts.
model AuditEvent {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  actorId   String?
  actorName String? // username at the time
  action    String // see AuditAction in src/lib/audit/labels.ts
  patientId String?
  subject   String // what was touched: a chart section, a record type, an account
  recordId  String?
  detail    String? // never clinical content: field names, counts, usernames
  ip        String?

  @@index([patientId, at])
  @@index([actorId, at])
  @@index([at])
}

model Patient {
  id                       String              @id @default(cuid())
  mrn                      String              @unique
  firstName                String
  lastName                 String
  dob                      DateTime            @db.Date
  sex                      Sex
  phone                    String?
  address                  String?
  preferredLanguage        String              @default("English")
  codeStatus               String              @default("Full code")
  allergyStatus            AllergyReviewStatus @default(not_reviewed)
  pcpId                    String?
  pcp                      Practitioner?       @relation("PCP", fields: [pcpId], references: [id])
  createdAt                DateTime            @default(now())
  preferredPharmacyId      String?
  preferredPharmacy        Pharmacy?           @relation(fields: [preferredPharmacyId], references: [id])
  // "Mark as reviewed" on the medication list.
  medsReviewedAt           DateTime?
  medsReviewedById         String?
  medsReviewedBy           Practitioner?       @relation("MedsReviewer", fields: [medsReviewedById], references: [id])
  // Confirmed or updated by the front desk at check-in.
  insurancePayer           String?
  insuranceMemberId        String?
  // Registration (src/app/patients/new). Seeded patients have no registrar.
  middleName               String?
  preferredName            String?
  email                    String?
  emergencyContactName     String?
  emergencyContactRelation String?
  emergencyContactPhone    String?
  insuranceGroup           String?
  // The policy holder, when it isn't the patient (e.g. a parent or spouse).
  subscriberName           String?
  subscriberRelation       String?
  registeredById           String?
  registeredBy             Practitioner?       @relation("RegisteredBy", fields: [registeredById], references: [id])
  // Set when the registrar saw possible duplicates and confirmed this is someone else.
  duplicateCheckNote       String?
  // A duplicate chart merged into another (src/lib/registration/merge.ts): its records moved
  // there, and it no longer appears in lists or search. Opening it goes to the chart it joined.
  mergedIntoId             String?
  mergedAt                 DateTime?
  mergedById               String?

  encounters     Encounter[]
  conditions     Condition[]
  allergies      AllergyIntolerance[]
  medications    MedicationRequest[]
  observations   Observation[]
  reports        DiagnosticReport[]
  notes          Note[]
  documents      DocumentReference[]
  importJobs     ImportJob[]
  orders         ServiceRequest[]
  dispenses      MedicationDispense[]
  refillRequests RefillRequest[]
  clinicalDocs   ClinicalDocument[]
  media          MediaItem[]
  conversations  Conversation[]
  visitDiagnoses EncounterDiagnosis[]

  @@index([lastName, firstName])
  // The duplicate-patient check looks up by date of birth.
  @@index([dob])
}

model Encounter {
  id         String          @id @default(cuid())
  patientId  String
  patient    Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type       EncounterType
  status     EncounterStatus
  reason     String?
  start      DateTime
  end        DateTime?
  providerId String?
  provider   Practitioner?   @relation(fields: [providerId], references: [id])

  // Scheduling. An appointment is an Encounter from booking on (FHIR keeps
  // Appointment separate; one row is enough for an outpatient clinic).
  visitType           String     @default("follow_up") // src/lib/scheduling/visit-types.ts
  bookingNote         String?
  statusAt            DateTime? // when the current status began, for wait timers
  arrivedAt           DateTime?
  room                String?
  chiefComplaint      String?
  allergiesReviewedAt DateTime?
  medsReviewedAt      DateTime?
  copayCents          Int?
  copayMethod         String? // PAYMENT_METHODS in src/lib/scheduling/workflow.ts; copayCents is in paisa
  cancelReason        String?
  // A rescheduled appointment is cancelled and points at its replacement.
  rescheduledToId     String?    @unique
  rescheduledTo       Encounter? @relation("Reschedule", fields: [rescheduledToId], references: [id])
  rescheduledFrom     Encounter? @relation("Reschedule")
  // Filled in by the provider on the visit screen (src/app/patients/[id]/visit), printed on
  // the visit prescription. Advice is free text, one item per line.
  advice              String?
  followUpInterval    String? // FOLLOW_UPS in src/lib/visits/follow-up.ts, or "date" when a date was picked
  followUpDate        DateTime?  @db.Date
  followUpNote        String?

  observations Observation[]
  notes        Note[]
  events       EncounterEvent[]
  diagnoses    EncounterDiagnosis[]

  @@index([patientId, start])
  @@index([start])
  @@index([providerId, start])
}

// Who did what to an appointment, and when: booked, checked in, roomed, cancelled...
// What a visit was for (ICD-10). The first by rank is the primary diagnosis. A diagnosis
// may also be on the problem list (conditionId), but a visit diagnosis is about this visit only.
model EncounterDiagnosis {
  id          String       @id @default(cuid())
  encounterId String
  encounter   Encounter    @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  patientId   String
  patient     Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  code        String? // ICD-10; blank when typed without one
  display     String
  rank        Int
  conditionId String?
  condition   Condition?   @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  addedById   String
  addedBy     Practitioner @relation("DiagnosisAddedBy", fields: [addedById], references: [id])
  createdAt   DateTime     @default(now())

  @@index([encounterId, rank])
  @@index([patientId])
  @@index([conditionId])
}

model EncounterEvent {
  id          String       @id @default(cuid())
  encounterId String
  encounter   Encounter    @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  action      String // see eventLabel in src/lib/scheduling/workflow.ts
  detail      String?
  at          DateTime     @default(now())
  byId        String
  by          Practitioner @relation(fields: [byId], references: [id])

  @@index([encounterId, at])
}

// A provider's recurring clinic session, e.g. Mondays 08:00-12:00 in 20-minute slots.
model ScheduleSession {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  weekday        Int // 0 = Sunday
  startMin       Int // minutes after midnight
  endMin         Int
  slotMinutes    Int          @default(20)

  @@index([practitionerId, weekday])
}

// Time taken off a provider's schedule: vacation, meetings, admin time.
model ScheduleBlock {
  id             String       @id @default(cuid())
  practitionerId String
  practitioner   Practitioner @relation("BlockProvider", fields: [practitionerId], references: [id], onDelete: Cascade)
  start          DateTime
  end            DateTime
  reason         String
  createdAt      DateTime     @default(now())

  @@index([practitionerId, start])
}

model Condition {
  id         String          @id @default(cuid())
  patientId  String
  patient    Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  code       String // ICD-10-CM
  display    String
  status     ConditionStatus
  onset      DateTime?       @db.Date
  resolvedAt DateTime?       @db.Date
  priority   Int             @default(100) // lower sorts first
  comment    String?

  // Medications and orders linked to this problem, for problem-based charting.
  medications    MedicationRequest[]
  orders         ServiceRequest[]
  visitDiagnoses EncounterDiagnosis[]

  @@index([patientId])
}

model AllergyIntolerance {
  id         String          @id @default(cuid())
  patientId  String
  patient    Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  substance  String
  type       AllergyType
  reaction   String?
  severity   AllergySeverity
  verified   Boolean         @default(false)
  recordedAt DateTime        @default(now())

  @@index([patientId])
}

// One prescription (FHIR MedicationRequest). A reorder, dose change or approved
// refill writes a new row whose priorId points at the one it replaces, so the
// list shows the current prescription and the chain is the history.
model MedicationRequest {
  id                  String             @id @default(cuid())
  patientId           String
  patient             Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  drug                String
  rxnorm              String?
  dose                String
  route               String
  frequency           String
  prn                 Boolean            @default(false)
  prnReason           String?
  indication          String?
  // The problem this medication treats. Set when prescribed or from the problem list.
  conditionId         String?
  condition           Condition?         @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  status              MedStatus
  start               DateTime           @db.Date // when the patient started this therapy
  end                 DateTime?          @db.Date
  prescriberId        String?
  prescriber          Practitioner?      @relation(fields: [prescriberId], references: [id])
  // The prescription itself.
  rxClass             RxClass            @default(e_prescribe)
  authoredAt          DateTime           @default(now())
  quantity            String?
  daysSupply          Int?
  refills             Int                @default(0) // authorized refills (fills after the first)
  daw                 Boolean            @default(false) // dispense as written, no substitution
  patientInstructions String?
  pharmacyNote        String?
  pharmacyId          String?
  pharmacy            Pharmacy?          @relation(fields: [pharmacyId], references: [id])
  sentAt              DateTime?
  priorId             String?            @unique
  prior               MedicationRequest? @relation("PriorRx", fields: [priorId], references: [id])
  next                MedicationRequest? @relation("PriorRx")
  endReason           String?
  endedById           String?
  endedBy             Practitioner?      @relation("MedEndedBy", fields: [endedById], references: [id])
  // Patient-reported use, from the last medication review.
  taking              PatientTaking?
  takingNote          String?
  takingAt            DateTime?
  // A resident's prescription waits on an attending's cosignature (it is still sent).
  cosignerId          String?
  cosigner            Practitioner?      @relation("MedCosigner", fields: [cosignerId], references: [id])
  cosignedAt          DateTime?

  dispenses      MedicationDispense[]
  refillRequests RefillRequest[]      @relation("RefillFor")
  refillResults  RefillRequest[]      @relation("RefillResult")

  @@index([patientId])
  @@index([conditionId])
  @@index([cosignerId, cosignedAt])
}

model Pharmacy {
  id        String  @id @default(cuid())
  name      String
  address   String
  phone     String
  fax       String?
  mailOrder Boolean @default(false)

  patients       Patient[]
  prescriptions  MedicationRequest[]
  dispenses      MedicationDispense[]
  refillRequests RefillRequest[]
}

// A pharmacy fill, as reported back by the pharmacy (simulated in the seed).
model MedicationDispense {
  id           String            @id @default(cuid())
  patientId    String
  patient      Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicationId String
  medication   MedicationRequest @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  pharmacyId   String?
  pharmacy     Pharmacy?         @relation(fields: [pharmacyId], references: [id])
  filledAt     DateTime
  quantity     String
  daysSupply   Int

  @@index([medicationId, filledAt])
}

// A pharmacy asking to renew a prescription that is out of refills.
model RefillRequest {
  id              String             @id @default(cuid())
  patientId       String
  patient         Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicationId    String
  medication      MedicationRequest  @relation("RefillFor", fields: [medicationId], references: [id], onDelete: Cascade)
  pharmacyId      String?
  pharmacy        Pharmacy?          @relation(fields: [pharmacyId], references: [id])
  status          RefillStatus       @default(requested)
  requestedAt     DateTime           @default(now())
  pharmacyComment String?
  pendedById      String?
  pendedBy        Practitioner?      @relation("RefillPendedBy", fields: [pendedById], references: [id])
  pendedAt        DateTime?
  pendNote        String?
  decidedById     String?
  decidedBy       Practitioner?      @relation("RefillDecidedBy", fields: [decidedById], references: [id])
  decidedAt       DateTime?
  decisionNote    String? // deny reason, or a note sent with the approval
  resultId        String? // the new prescription an approval wrote
  result          MedicationRequest? @relation("RefillResult", fields: [resultId], references: [id])

  @@index([status])
  @@index([patientId])
}

model Observation {
  id                   String              @id @default(cuid())
  patientId            String
  patient              Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId          String?
  encounter            Encounter?          @relation(fields: [encounterId], references: [id])
  reportId             String?
  report               DiagnosticReport?   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  category             ObservationCategory
  code                 String // LOINC, or a local code for vitals without one
  display              String
  valueNum             Float?
  valueText            String?
  unit                 String? // UCUM
  refLow               Float?
  refHigh              Float?
  refText              String?
  flag                 Flag?
  effectiveAt          DateTime
  sortOrder            Int                 @default(0)
  // Entered in error (wrong patient, duplicate, mistyped): hidden from the chart, Inbox and
  // checks, kept for the record. See src/lib/db.ts.
  enteredInErrorAt     DateTime?
  enteredInErrorReason String?
  enteredInErrorById   String?
  // A result whose number was typed or read wrong and fixed later. The value above is the
  // corrected one; each earlier value is kept in ObservationCorrection.
  correctedAt          DateTime?
  corrections          ObservationCorrection[]

  @@index([patientId, category, effectiveAt])
}

// The value a lab result had before someone corrected it, with who changed it, when and why.
model ObservationCorrection {
  id            String       @id @default(cuid())
  observationId String
  observation   Observation  @relation(fields: [observationId], references: [id], onDelete: Cascade)
  valueNum      Float?
  valueText     String?
  unit          String?
  refLow        Float?
  refHigh       Float?
  refText       String?
  flag          Flag?
  reason        String
  correctedById String
  correctedBy   Practitioner @relation(fields: [correctedById], references: [id])
  correctedAt   DateTime     @default(now())

  @@index([observationId, correctedAt])
}

model DiagnosticReport {
  id                   String          @id @default(cuid())
  patientId            String
  patient              Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  code                 String
  display              String // e.g. "Complete blood count"
  performer            String // lab name
  effectiveAt          DateTime
  issuedAt             DateTime
  status               ReportStatus
  source               ReportSource    @default(ordered)
  verifiedAt           DateTime?
  verifiedById         String?
  verifiedBy           Practitioner?   @relation("VerifiedReports", fields: [verifiedById], references: [id])
  importJobId          String?
  importJob            ImportJob?      @relation(fields: [importJobId], references: [id])
  orderId              String?
  order                ServiceRequest? @relation(fields: [orderId], references: [id])
  // Inbox acknowledgement by the responsible clinician.
  reviewedAt           DateTime?
  reviewedById         String?
  reviewedBy           Practitioner?   @relation("ReviewedReports", fields: [reviewedById], references: [id])
  reviewComment        String?
  // Last time one of its values was corrected (see ObservationCorrection).
  correctedAt          DateTime?
  // Entered in error (wrong patient, duplicate, mistyped): hidden from the chart, Inbox and
  // checks, kept for the record. See src/lib/db.ts.
  enteredInErrorAt     DateTime?
  enteredInErrorReason String?
  enteredInErrorById   String?

  observations Observation[]

  @@index([patientId, effectiveAt])
  @@index([reviewedAt])
}

model Note {
  id                   String        @id @default(cuid())
  patientId            String
  patient              Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  encounterId          String?
  encounter            Encounter?    @relation(fields: [encounterId], references: [id])
  type                 NoteType
  templateId           String? // src/lib/notes/library.ts
  title                String
  body                 String
  status               NoteStatus
  authorId             String
  author               Practitioner  @relation("NoteAuthor", fields: [authorId], references: [id])
  serviceAt            DateTime      @default(now()) // date of service
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @default(now()) @updatedAt
  signedAt             DateTime?
  // Supervision: a note routed for cosignature stays pending_cosign until the
  // cosigner signs, optionally adding an attestation.
  cosignerId           String?
  cosigner             Practitioner? @relation("NoteCosigner", fields: [cosignerId], references: [id])
  cosignedAt           DateTime?
  cosignText           String?
  // Set when a signed note's text was changed after signing. Each earlier
  // version is kept in NoteVersion.
  editedAt             DateTime?
  editedById           String?
  editedBy             Practitioner? @relation("NoteEditor", fields: [editedById], references: [id])
  // A signed note deleted from the chart: hidden from every list and check,
  // kept for the record. See src/lib/db.ts.
  enteredInErrorAt     DateTime?
  enteredInErrorReason String?
  enteredInErrorById   String?

  addenda  NoteAddendum[]
  versions NoteVersion[]

  @@index([patientId, serviceAt])
  @@index([authorId, status])
  @@index([cosignerId, status])
}

// Signed notes are never edited; later information is appended as an addendum.
model NoteAddendum {
  id       String       @id @default(cuid())
  noteId   String
  note     Note         @relation(fields: [noteId], references: [id], onDelete: Cascade)
  body     String
  authorId String
  author   Practitioner @relation(fields: [authorId], references: [id])
  signedAt DateTime     @default(now())

  @@index([noteId])
}

// A signed note's text as it stood before an edit. The note row always holds the
// current version; these are the earlier ones, oldest first by number (1 = as first signed).
model NoteVersion {
  id         String       @id @default(cuid())
  noteId     String
  note       Note         @relation(fields: [noteId], references: [id], onDelete: Cascade)
  number     Int
  title      String
  type       NoteType
  body       String
  // Who signed this version and when: the original signer, or the person who edited it in.
  signedById String
  signedBy   Practitioner @relation("NoteVersionSigner", fields: [signedById], references: [id])
  signedAt   DateTime
  // When it was replaced by the next version.
  replacedAt DateTime     @default(now())

  @@unique([noteId, number])
}

// A clinician's own dot phrase. It overrides a system phrase with the same name.
model SmartPhrase {
  id          String       @id @default(cuid())
  ownerId     String
  owner       Practitioner @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name        String
  description String       @default("")
  body        String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([ownerId, name])
}

// An uploaded file (photo, scan or PDF). Bytes live in Postgres for v1; move to
// object storage when files get large or numerous.
model DocumentReference {
  id           String       @id @default(cuid())
  patientId    String
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind         String       @default("lab_report")
  fileName     String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  data         Bytes
  uploadedById String
  uploadedBy   Practitioner @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime     @default(now())
  importJobId  String?
  importJob    ImportJob?   @relation(fields: [importJobId], references: [id], onDelete: Cascade)
  position     Int          @default(0) // page order within an import

  @@index([patientId, uploadedAt])
}

// One lab report import: the uploaded pages, what Claude read from them, and the
// clinician's reviewed draft. Nothing reaches the chart until it is filed.
model ImportJob {
  id          String        @id @default(cuid())
  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  kind        ImportKind    @default(lab)
  // Uploaded as "any report": Claude first decides whether it is a lab table or a
  // written document, then reads it as that kind.
  autoKind    Boolean       @default(false)
  status      ImportStatus  @default(extracting)
  model       String?
  extraction  Json? // raw model output, kept for audit
  draft       Json? // the review screen's working copy
  error       String?
  createdById String
  createdBy   Practitioner  @relation("ImportCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  filedAt     DateTime?
  filedById   String?
  filedBy     Practitioner? @relation("ImportFiledBy", fields: [filedById], references: [id])

  documents   DocumentReference[]
  reports     DiagnosticReport[]
  clinicalDoc ClinicalDocument?

  @@index([patientId, createdAt])
  @@index([status])
}

// An order (FHIR ServiceRequest, or MedicationRequest once a prescription is
// signed). `code` is the orderable's code from src/lib/orders/catalog.ts.
model ServiceRequest {
  id             String        @id @default(cuid())
  patientId      String
  patient        Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type           OrderType
  code           String
  display        String
  status         OrderStatus   @default(pending)
  priority       OrderPriority @default(routine)
  indication     String?
  // The problem this order is for. Set when ordered or from the problem list.
  conditionId    String?
  condition      Condition?    @relation(fields: [conditionId], references: [id], onDelete: SetNull)
  instructions   String?
  details        Json? // medication: dose, route, frequency, quantity, refills
  orderSet       String?
  expectedAt     DateTime?     @db.Date
  orderedById    String
  orderedBy      Practitioner  @relation(fields: [orderedById], references: [id])
  createdAt      DateTime      @default(now())
  signedAt       DateTime?
  completedAt    DateTime?
  discontinuedAt DateTime?
  medicationId   String? // the MedicationRequest a signed prescription created

  reports      DiagnosticReport[]
  clinicalDocs ClinicalDocument[]

  @@index([patientId, status])
  @@index([orderedById, status])
  @@index([conditionId])
}

// An outside clinical document filed from a verified import: an imaging report,
// discharge summary, referral or consult letter. `content` holds the reviewed
// structure (sections, diagnoses, medications, follow-ups; see
// src/lib/documents/draft.ts DocContent). The source pages stay on the import job.
model ClinicalDocument {
  id                   String          @id @default(cuid())
  patientId            String
  patient              Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  type                 ClinicalDocType
  title                String
  organization         String?
  author               String?
  serviceDate          DateTime        @db.Date
  content              Json
  importJobId          String?         @unique
  importJob            ImportJob?      @relation(fields: [importJobId], references: [id])
  // The imaging or referral order this document answers, if any.
  orderId              String?
  order                ServiceRequest? @relation(fields: [orderId], references: [id])
  filedById            String
  filedBy              Practitioner    @relation("DocFiledBy", fields: [filedById], references: [id])
  filedAt              DateTime        @default(now())
  // Inbox acknowledgement by the PCP (or the ordering clinician).
  reviewedAt           DateTime?
  reviewedById         String?
  reviewedBy           Practitioner?   @relation("DocReviewedBy", fields: [reviewedById], references: [id])
  reviewComment        String?
  // Entered in error (wrong patient, duplicate, mistyped): hidden from the chart, Inbox and
  // checks, kept for the record. See src/lib/db.ts.
  enteredInErrorAt     DateTime?
  enteredInErrorReason String?
  enteredInErrorById   String?

  @@index([patientId, serviceDate])
  @@index([reviewedAt])
}

// Secure staff chat. Messages are working communication between staff, not
// part of the legal record; members can't edit or delete what they sent.
model Conversation {
  id            String               @id @default(cuid())
  // Null for a one-to-one or an unnamed group (named after its members).
  title         String?
  // Optional patient context, shown as a banner with a link to the chart.
  patientId     String?
  patient       Patient?             @relation(fields: [patientId], references: [id])
  createdById   String
  createdBy     Practitioner         @relation("ConversationCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime             @default(now())
  lastMessageAt DateTime             @default(now())
  members       ConversationMember[]
  messages      ChatMessage[]

  @@index([patientId])
  @@index([lastMessageAt])
}

model ConversationMember {
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  practitionerId String
  practitioner   Practitioner @relation(fields: [practitionerId], references: [id])
  joinedAt       DateTime     @default(now())
  // Everything sent up to here has been read; drives unread counts and "Read by".
  lastReadAt     DateTime?
  // Set when a member leaves; they lose access until someone adds them back.
  leftAt         DateTime?
  muted          Boolean      @default(false)

  @@id([conversationId, practitionerId])
  @@index([practitionerId])
}

model ChatMessage {
  id             String          @id @default(cuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         Practitioner    @relation(fields: [senderId], references: [id])
  kind           ChatMessageKind @default(text)
  body           String
  urgent         Boolean         @default(false)
  createdAt      DateTime        @default(now())

  @@index([conversationId, createdAt])
}

// The chart's Media tab: clinical photos (hands, skin, wounds, findings), scanned
// paperwork and any other image or PDF kept as is. Named and described by staff;
// a photo of a report can also be sent to Import to be read into the chart.
model MediaItem {
  id           String       @id @default(cuid())
  patientId    String
  patient      Patient      @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title        String
  category     String // src/lib/media/categories.ts
  bodySite     String?
  description  String?
  takenAt      DateTime // when the photo was taken or the paper dated, as staff entered it
  fileName     String
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  data         Bytes
  thumb        Bytes? // small JPEG for the grid
  uploadedById String
  uploadedBy   Practitioner @relation(fields: [uploadedById], references: [id])
  uploadedAt   DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  updatedById  String?
  importJobId  String? // last time it was sent to Import

  enteredInErrorAt     DateTime?
  enteredInErrorReason String?
  enteredInErrorById   String?

  @@index([patientId, takenAt])
}
