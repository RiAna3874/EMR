DATABASE_URL="postgresql://meridian:meridian@localhost:5432/meridian"
# Claude API key for reading lab reports and outside documents (Import tab).
ANTHROPIC_API_KEY=""
# Dev only: skip Claude and use a saved extraction, e.g. samples/synthetic-lab-report.extraction.json
# MERIDIAN_EXTRACTION_FIXTURE="samples/synthetic-lab-report.extraction.json"
# Dev only: read clinical documents from saved transcriptions in this folder, matched by upload file name.
# MERIDIAN_DOCUMENT_FIXTURES="samples"
# List the synthetic demo accounts on the sign-in page in a production build (always shown in dev).
# Public demos only; never on a live clinic site.
# MERIDIAN_DEMO_ACCOUNTS="1"

# --- Live sites (see docs/DEPLOY.md) ---
# The clinic's time zone. "Today" and visit times use the server clock.
# TZ="America/New_York"
# Asked for once at /setup to create the first administrator in production. 16+ characters.
# MERIDIAN_SETUP_TOKEN=""
# Printed on letters, requisitions and prescriptions.
# MERIDIAN_CLINIC_NAME="Lakeview Family Medicine"
# MERIDIAN_CLINIC_ADDRESS="400 Lakeshore Drive, Suite 200, Lakeview, OR 97630"
# MERIDIAN_CLINIC_PHONE="(555) 200-1000"
# MERIDIAN_CLINIC_FAX="(555) 200-1001"
# Set only when everything in docs/GO-LIVE.md is done. Removes the "not for real patients" notice.
# MERIDIAN_CLEARED_FOR_REAL_PATIENTS="1"
