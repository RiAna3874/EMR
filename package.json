{
  "name": "meridian-emr",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "prisma migrate deploy && prisma generate",
    "db:seed": "prisma db seed",
    "db:reset": "tsx scripts/db-empty.ts --guard && prisma migrate reset --force",
    "db:empty": "tsx scripts/db-empty.ts",
    "drugs:dgda": "tsx scripts/dgda-import.ts",
    "typecheck": "tsc --noEmit",
    "postinstall": "prisma generate",
    "test": "tsx --test 'src/**/*.test.ts'"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@prisma/client": "^6.19.3",
    "@types/qrcode": "^1.5.5",
    "next": "15.5.27",
    "qrcode": "^1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.27",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.30"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
